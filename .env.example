# Database (do not commit real credentials)
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
PGUSER=postgres
PGPASSWORD=change-me

# Frontend links used in emails (no trailing slash, no path)
FRONTEND_BASE_URL=http://localhost:3000

# Billing checkout redirect base URL (no trailing slash)
FRONTEND_URL=https://manage-system-phi.vercel.app

# Public deployment URL template. {slug} is replaced by the site slug.
# Leave empty to return publishedUrl = null.
PUBLISHED_URL_TEMPLATE=https://sites.example.com/{slug}

# Custom domains. Only real configured values are returned to the frontend;
# a missing value omits the corresponding DNS record.
# CNAME target used for www/subdomains.
DOMAINS_CNAME_TARGET=sites.example.com
# Comma-separated A records used for apex domains (example values only).
DOMAINS_A_RECORDS=203.0.113.10
# Platform base domain and all of its subdomains cannot be used as custom domains.
DOMAINS_PLATFORM_BASE_DOMAIN=example.com

# Email delivery
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_FROM=Site Builder <no-reply@sitebuilder.local>
MAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-fake-placeholder
BREVO_BASE_URL=https://api.brevo.com
BREVO_CONNECT_TIMEOUT=3s
BREVO_READ_TIMEOUT=8s
BREVO_MAX_RETRIES=2
AUTH_EMAIL_LOCALE=az
AUTH_RESEND_COOLDOWN=60s

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
