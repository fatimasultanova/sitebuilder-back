# Database (do not commit real credentials)
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
PGUSER=postgres
PGPASSWORD=change-me

# Frontend links used in emails (no trailing slash, no path)
FRONTEND_BASE_URL=http://localhost:3000

# Email delivery
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_FROM=Site Builder <no-reply@sitebuilder.local>
MAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-fake-placeholder
BREVO_BASE_URL=https://api.brevo.com
BREVO_CONNECT_TIMEOUT=3s
BREVO_READ_TIMEOUT=8s
BREVO_MAX_RETRIES=2
AUTH_EMAIL_LOCALE=az
AUTH_RESEND_COOLDOWN=60s

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
